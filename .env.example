# Development/test defaults. Use no real secrets or learner data here.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
DATA_ENABLED=false
DATABASE_URL=
TURSO_AUTH_TOKEN_2=
APP_BUILD_SHA=unknown
# Node adapter runtime. Keep local servers loopback-only.
HOST=127.0.0.1
PORT=3000
# 11 MiB admits 10 MB Library files plus multipart overhead.
# The app caps other routes at 512 KiB and individual files at 10 MB.
BODY_SIZE_LIMIT=11534336
TYPESAFE_API_KEY=
OPENAI_API_KEY=
