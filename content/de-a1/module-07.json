    {
      "skill_id": "de-a1-027",
      "title": "Negating clauses and constituents with nicht",
      "explanation": "Nicht negates verbs, adjectives, adverbs and phrases. To negate the whole clause, put nicht at the end: Ich arbeite heute nicht. Before an adjective, nicht stands directly in front of it: Das Buch ist nicht neu. To negate one part, put nicht in front of that part: Wir fahren nicht nach Berlin. Nicht never stands before the finite verb in a statement, so Ich nicht arbeite is wrong.",
      "examples": [
        {
          "de": "Ich arbeite heute nicht.",
          "en": "I am not working today."
        },
        {
          "de": "Das Buch ist nicht neu.",
          "en": "The book is not new."
        },
        {
          "de": "Wir fahren nicht nach Berlin.",
          "en": "We are not driving to Berlin."
        }
      ],
      "references": ["GOETHE-A1"],
