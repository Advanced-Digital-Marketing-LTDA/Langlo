    {
      "skill_id": "de-a1-025",
      "title": "Negating noun phrases with kein",
      "explanation": "Kein negates a noun phrase that would have ein or no article. It has the endings of ein: kein (masculine and neuter, nominative), keine (feminine and plural), and keinen for a masculine direct object. Ich habe einen Hund becomes Ich habe keinen Hund; Wir haben ein Auto becomes Wir haben kein Auto; Anna hat Kinder becomes Anna hat keine Kinder. Use kein with uncountable nouns too: Ich habe kein Geld.",
      "examples": [
        {
          "de": "Ich habe keinen Hund.",
          "en": "I have no dog."
        },
        {
          "de": "Wir haben kein Auto.",
          "en": "We have no car."
        },
        {
          "de": "Anna hat keine Kinder.",
          "en": "Anna has no children."
        }
      ],
      "references": ["GOETHE-A1"],
