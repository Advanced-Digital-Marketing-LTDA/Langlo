    {
      "skill_id": "de-a1-018",
      "title": "Perfekt of frequent everyday verbs",
      "explanation": "The Perfekt is the usual tense for talking about the past. It uses haben or sein in second position and the past participle at the end: Ich habe gestern gearbeitet. Regular participles are ge- + stem + -t (gearbeitet, gelernt, gespielt, gemacht, gekauft). Some frequent verbs have irregular participles: gegessen, gesehen, gesprochen, gefahren, gekommen, gegangen. Verbs of movement or change of place usually take sein: Wir sind nach Berlin gefahren.",
      "examples": [
        {
          "de": "Ich habe gestern gearbeitet.",
          "en": "I worked yesterday."
        },
        {
          "de": "Anna hat Deutsch gelernt.",
          "en": "Anna learned German."
        },
        {
          "de": "Wir sind nach Berlin gefahren.",
          "en": "We drove to Berlin."
        }
      ],
      "references": ["GOETHE-A1"],
      "version": {
        "id": "de-a1-018@1",
        "version": 1,
        "questions": [
          {
