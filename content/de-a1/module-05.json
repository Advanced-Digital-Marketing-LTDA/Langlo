    {
      "skill_id": "de-a1-020",
      "title": "Imperatives: du, ihr and Sie",
      "explanation": "Imperatives give instructions. For one friend (du) use the verb stem, with an optional -e: Lerne Deutsch! / Lern Deutsch! For several friends (ihr) use the ihr form: Lernt Deutsch! For the formal address put the verb first and keep Sie: Lernen Sie Deutsch! Verbs that change the stem vowel in du keep it: Sprich! Lies! Nimm! Sei is the imperative of sein. Separable prefixes go to the end: Steh auf! Add bitte to be polite.",
      "examples": [
        {
          "de": "Lerne Deutsch!",
          "en": "Learn German!"
        },
        {
          "de": "Kommt bitte pünktlich!",
          "en": "Please come on time! (you all)"
        },
        {
          "de": "Sprechen Sie langsam!",
          "en": "Speak slowly! (formal)"
        }
      ],
      "references": ["GOETHE-A1"],
      "version": {
        "id": "de-a1-020@1",
