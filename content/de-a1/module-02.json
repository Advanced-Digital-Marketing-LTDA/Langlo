    {
      "skill_id": "de-a1-011",
      "title": "Choosing definite and indefinite articles",
      "explanation": "Use the indefinite article (ein, eine) when you introduce something new: Da ist ein Kind. Use the definite article (der, die, das) when it is already known or specific: Das Kind ist klein. With a profession or nationality after sein, German usually has no article: Anna ist Lehrerin. The gender of the noun decides the form, so learn nouns with their article.",
      "examples": [
        {
          "de": "Da ist ein Kind.",
          "en": "There is a child."
        },
        {
          "de": "Das Kind ist klein.",
          "en": "The child is small."
        },
        {
          "de": "Anna ist Lehrerin.",
          "en": "Anna is a teacher."
        }
      ],
      "references": ["GOETHE-A1"],
