    {
      "skill_id": "de-a1-007",
      "title": "Noun gender and nominative articles",
      "explanation": "Every German noun has a grammatical gender: masculine (der), feminine (die) or neuter (das). The nominative plural article is always die. Learn each noun together with its article: der Mann, die Frau, das Kind, die Kinder. The indefinite article in the nominative is ein for masculine and neuter and eine for feminine: ein Mann, eine Frau, ein Kind. All nouns are written with a capital letter. Endings help a little: nouns in -ung, -heit and -keit are feminine, and nouns in -chen are neuter.",
      "examples": [
        {
          "de": "Der Tisch ist neu.",
          "en": "The table is new."
        },
        {
          "de": "Die Lampe ist neu.",
          "en": "The lamp is new."
        },
        {
          "de": "Das Buch ist neu.",
          "en": "The book is new."
        }
      ],
      "references": ["GOETHE-A1"],
      "version": {
        "id": "de-a1-007@1",
        "version": 1,
        "questions": [
