    {
      "skill_id": "de-a1-009",
      "title": "Nominative and accusative articles",
      "explanation": "The subject of a sentence is in the nominative; the direct object, the person or thing that receives the action, is in the accusative. Only the masculine singular changes: der becomes den and ein becomes einen. Feminine, neuter and plural forms stay the same: die Frau, das Buch, die Kinder, eine Lampe, ein Buch. Compare Der Mann sieht den Hund (subject der Mann, object den Hund).",
      "examples": [
        {
          "de": "Ich sehe den Mann.",
          "en": "I see the man."
        },
        {
          "de": "Anna kauft eine Lampe.",
          "en": "Anna buys a lamp."
        },
        {
          "de": "Max hat einen Hund.",
          "en": "Max has a dog."
        }
      ],
      "references": ["GOETHE-A1"],
      "version": {
        "id": "de-a1-009@1",
        "version": 1,
        "questions": [
