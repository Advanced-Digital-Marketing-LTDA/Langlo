    {
      "skill_id": "de-a1-006",
      "title": "Negation: kein with nouns, nicht with clauses",
      "explanation": "German has two main negation words. Kein negates a noun that would have ein or no article: Das ist ein Buch becomes Das ist kein Buch; Ich habe Zeit becomes Ich habe keine Zeit. Kein takes the endings of ein (kein, keine, kein). Nicht negates a verb, an adjective or a whole clause: Anna arbeitet nicht. Das Buch ist nicht neu. Do not use nicht directly in front of a noun that has no article.",
      "examples": [
        {
          "de": "Das ist kein Buch.",
          "en": "That is not a book."
        },
        {
          "de": "Anna arbeitet nicht.",
          "en": "Anna does not work."
        },
        {
          "de": "Ich habe keine Zeit.",
          "en": "I have no time."
        }
      ],
      "references": ["GOETHE-A1"],
