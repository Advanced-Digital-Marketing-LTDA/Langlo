    {
      "skill_id": "de-a1-004",
      "title": "Present tense of regular verbs",
      "explanation": "Regular verbs drop -en from the infinitive and add endings to the stem: ich wohne, du wohnst, er/sie/es wohnt, wir wohnen, ihr wohnt, sie/Sie wohnen. Stems ending in -t or -d add an extra -e before -st and -t: du arbeitest, er arbeitet, ihr arbeitet. The German present tense covers both 'I live' and 'I am living'.",
      "examples": [
        {
          "de": "Ich wohne in Wien.",
          "en": "I live in Vienna."
        },
        {
          "de": "Du lernst Deutsch.",
          "en": "You learn German."
        },
        {
          "de": "Wir kommen aus Spanien.",
          "en": "We come from Spain."
        }
      ],
      "references": ["GOETHE-A1"],
