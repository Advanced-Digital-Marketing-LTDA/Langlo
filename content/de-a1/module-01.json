    {
      "skill_id": "de-a1-002",
      "title": "Yes/no questions: the verb comes first",
      "explanation": "A yes/no question starts with the finite verb, followed by the subject: Wohnst du in Berlin? To turn a statement into a yes/no question, move the verb to the front and keep the other words: Max spielt Tennis becomes Spielt Max Tennis? German has no helper verb like English 'do', so the main verb itself goes first. Answer with Ja or Nein, then a full clause: Ja, ich wohne in Berlin.",
      "examples": [
        {
          "de": "Wohnst du in Berlin?",
          "en": "Do you live in Berlin?"
        },
        {
          "de": "Spielt Max Fußball?",
          "en": "Does Max play football?"
        },
        {
          "de": "Kommt ihr aus Spanien?",
          "en": "Do you (all) come from Spain?"
        }
      ],
      "references": ["GOETHE-A1"],
