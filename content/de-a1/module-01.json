    {
      "skill_id": "de-a1-001",
      "title": "Main clauses: the verb in second position",
      "explanation": "In a German statement the finite verb (the verb with a personal ending) stands in second position. The first position can be the subject (Anna wohnt in Berlin) or another element such as a time word (Heute lernt Anna Deutsch). When something else comes first, the subject moves behind the verb. The second position means second element, not second word: a longer first element still counts as one.",
      "examples": [
        {
          "de": "Anna wohnt in Berlin.",
          "en": "Anna lives in Berlin."
        },
        {
          "de": "Heute lernt Anna Deutsch.",
          "en": "Today Anna learns German."
        },
        {
          "de": "Wir spielen Fußball.",
          "en": "We play football."
        }
      ],
      "references": ["GOETHE-A1", "COE-CV20"],
