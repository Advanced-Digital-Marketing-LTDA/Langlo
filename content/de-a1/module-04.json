    {
      "skill_id": "de-a1-012",
      "title": "Possessive determiners",
      "explanation": "Possessive determiners show who owns something: mein (my), dein (your, one friend), sein (his, its), ihr (her), unser (our), euer (your, several friends), ihr (their), Ihr (your, formal). They take the endings of ein: mein Bruder, meine Schwester, mein Kind, meine Eltern. Choose the form by the gender of the noun that follows, not by the owner: Seine Schwester can belong to a man.",
      "examples": [
        {
          "de": "Das ist mein Bruder.",
          "en": "That is my brother."
        },
        {
          "de": "Meine Schwester wohnt in Wien.",
          "en": "My sister lives in Vienna."
        },
        {
          "de": "Unser Haus ist klein.",
          "en": "Our house is small."
        }
      ],
      "references": ["GOETHE-A1"],
