    {
      "skill_id": "pt-b2-013",
      "title": "Gerund clauses",
      "explanation": "A gerund clause (-ndo) adds an action that happens at the same time as the main verb, or expresses manner, cause or condition. It shares the subject of the main verb: ela saiu correndo, estando cansado, ele dormiu cedo, chegando em casa, liguei para ela. It is formed by replacing -r with -ndo: correr gives correndo, ser gives sendo, estar gives estando. The gerund does not follow a preposition (use ao + infinitive: ao chegar). Do not use the gerund for an action that happens after the main verb, and do not use the gerundismo vou estar enviando.",
      "examples": [
        {
          "pt": "Ela saiu correndo.",
          "en": "She left running."
        },
        {
          "pt": "Estando cansado, ele dormiu cedo.",
          "en": "Being tired, he slept early."
        },
        {
          "pt": "Chegando em casa, liguei para ela.",
          "en": "Arriving home, I called her."
        }
      ],
      "references": ["COE-CV20"],
      "version": {
        "id": "pt-b2-013@1",
        "version": 1,
