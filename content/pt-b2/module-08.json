  "lessons": [
    {
      "skill_id": "pt-b2-036",
      "title": "Written and spoken register",
      "explanation": "Brazilian Portuguese has a spoken register and a formal written one, and a B2 reader recognises both. Speech shortens words: pra for para, tá for está, cadê for onde está, and the tag question né. Speech also uses a gente where formal writing uses nós, and você or tu where formal writing may use o senhor or a senhora; vós is archaic and appears only in old texts and liturgy. In formal writing, spell the full forms: vou para casa, está tudo bem, nós fomos ao cinema. Do not use the spoken shortcuts in an essay or a formal letter, and do not use the formal forms with the wrong verb ending (nós foi is wrong).",
      "examples": [
        {
          "pt": "Vou para casa agora.",
          "en": "I am going home now."
        },
        {
          "pt": "Está tudo bem?",
          "en": "Is everything fine?"
        },
        {
          "pt": "Nós fomos ao cinema.",
          "en": "We went to the cinema."
        }
      ],
      "references": ["COE-CV20"],
