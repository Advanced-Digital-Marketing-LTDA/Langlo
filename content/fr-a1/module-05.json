    {
      "skill_id": "fr-a1-020",
      "title": "Joining short clauses: et, mais, ou, parce que, donc",
      "explanation": "Connectors join two short clauses. Et means and, mais means but, ou means or (without an accent, unlike où, where), parce que means because, donc means so, puis means then and aussi means also. Parce que becomes parce qu' before a vowel or a silent h: parce qu'il travaille. Each clause keeps its own subject and verb: Il travaille et elle étudie.",
      "examples": [
        {
          "fr": "Il travaille et elle étudie.",
          "en": "He works and she studies."
        },
        {
          "fr": "Je veux voyager, mais je travaille.",
          "en": "I want to travel, but I am working."
        },
        {
          "fr": "Elle est contente parce que Marie arrive.",
          "en": "She is happy because Marie is arriving."
        }
      ],
      "references": ["FEI-INV"],
