    {
      "skill_id": "fr-a1-012",
      "title": "Possessive determiners",
      "explanation": "Possessive determiners agree with the noun that is owned, not with the owner. My: mon (masculine), ma (feminine), mes (plural). Your (one friend): ton, ta, tes. His, her or its: son, sa, ses. Our: notre (singular), nos (plural). Your (polite or several people): votre, vos. Their: leur (singular), leurs (plural). Before a feminine noun that starts with a vowel the masculine form is used: mon amie. Because son, sa and ses agree with the noun, son frère can mean his brother or her brother.",
      "examples": [
        {
          "fr": "Ma sœur habite à Lyon.",
          "en": "My sister lives in Lyon."
        },
        {
          "fr": "Nous aimons notre maison.",
          "en": "We like our house."
        },
        {
          "fr": "Il mange son pain.",
          "en": "He is eating his bread."
        }
      ],
      "references": ["FEI-INV"],
