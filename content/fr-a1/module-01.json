    {
      "skill_id": "fr-a1-001",
      "title": "Short statements: a subject and a verb",
      "explanation": "A basic French statement starts with a subject (a name, a noun such as le train, or a pronoun) followed by a conjugated verb: Marie travaille. The verb must be a conjugated form, not the dictionary form (the infinitive): say Le bus arrive, not Le bus arriver. Extra information, such as a place or a time, usually comes after the verb.",
      "examples": [
        {
          "fr": "Marie travaille.",
          "en": "Marie works."
        },
        {
          "fr": "Le train arrive à midi.",
          "en": "The train arrives at noon."
        },
        {
          "fr": "Paul mange une pomme.",
          "en": "Paul is eating an apple."
        }
      ],
