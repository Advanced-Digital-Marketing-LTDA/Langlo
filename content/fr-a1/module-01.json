    {
      "skill_id": "fr-a1-002",
      "title": "Subject pronouns",
      "explanation": "French subject pronouns are je (I), tu (you, one person you know well), il (he), elle (she), on (we, informal, or people in general), nous (we), vous (you, polite or more than one person), ils (they, men or a mixed group) and elles (they, women only). Je becomes j' before a vowel or a silent h: j'aime, j'habite. A group with at least one man takes ils.",
      "examples": [
        {
          "fr": "Elle chante.",
          "en": "She sings."
        },
        {
          "fr": "J'habite à Lyon.",
          "en": "I live in Lyon."
        },
        {
          "fr": "Vous parlez français ?",
          "en": "Do you speak French?"
        }
      ],
      "references": ["FEI-INV"],
