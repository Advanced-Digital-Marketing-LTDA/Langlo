    {
      "skill_id": "fr-a1-023",
      "title": "Reflexive verbs for daily routine",
      "explanation": "Reflexive verbs have a pronoun before the verb that refers back to the subject: me (je), te (tu), se (il, elle, on, ils, elles), nous, vous. Me, te and se become m', t' and s' before a vowel or a silent h: je m'appelle. Frequent verbs: se lever (to get up), se coucher (to go to bed), se réveiller (to wake up), s'appeler (to be called). Se lever has a spelling change: je me lève, tu te lèves, il se lève, nous nous levons, vous vous levez, ils se lèvent.",
      "examples": [
        {
          "fr": "Je m'appelle Marie.",
          "en": "My name is Marie."
        },
        {
          "fr": "Il se lève à sept heures.",
          "en": "He gets up at seven o'clock."
        },
        {
          "fr": "Elles se réveillent tôt.",
          "en": "They wake up early."
        }
      ],
      "references": ["FEI-INV"],
