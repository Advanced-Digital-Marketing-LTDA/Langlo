    {
      "skill_id": "fr-a1-007",
      "title": "Yes/no questions: intonation and est-ce que",
      "explanation": "There are two easy ways to ask a yes/no question in French. In speech you can keep the statement word order and raise your voice at the end: Tu parles français ? Or you can put est-ce que before the statement: Est-ce que tu parles français ? Est-ce que becomes est-ce qu' before a vowel or a silent h: Est-ce qu'il habite ici ? The usual answers are oui (yes) and non (no).",
      "examples": [
        {
          "fr": "Vous aimez le thé ?",
          "en": "Do you like tea?"
        },
        {
          "fr": "Est-ce que tu travailles demain ?",
          "en": "Are you working tomorrow?"
        },
        {
          "fr": "Est-ce qu'elle habite à Nantes ?",
          "en": "Does she live in Nantes?"
        }
      ],
      "references": ["FEI-INV"],
