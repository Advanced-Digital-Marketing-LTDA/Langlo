    {
      "skill_id": "fr-a1-006",
      "title": "Simple negation with ne ... pas",
      "explanation": "To make a French statement negative, put ne before the conjugated verb and pas after it: Marie ne travaille pas. Ne becomes n' before a vowel or a silent h: Je n'aime pas le café, Elle n'habite pas ici. The verb stays in the same place in the sentence, so ne and pas wrap around it. Spoken French often drops ne, but in writing keep both parts.",
      "examples": [
        {
          "fr": "Je ne parle pas anglais.",
          "en": "I do not speak English."
        },
        {
          "fr": "Il n'habite pas à Lyon.",
          "en": "He does not live in Lyon."
        },
        {
          "fr": "Nous ne mangeons pas.",
          "en": "We are not eating."
        }
      ],
      "references": ["FEI-INV"],
