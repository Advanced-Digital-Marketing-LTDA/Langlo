    {
      "skill_id": "en-a1-006",
      "title": "Yes/no questions with be and do",
      "explanation": "For yes/no questions with be, put be before the subject: Are you a teacher? Is she at home? For other verbs in the present simple, use do or does before the subject and the base verb: Do you like tea? Does she work here? Use does with he, she and it. Short answers repeat the auxiliary: Yes, I do. No, he doesn't. Yes, she is. No, they aren't.",
      "examples": [
        {
          "en": "Are you a teacher?"
        },
        {
          "en": "Do you like tea?"
        },
        {
          "en": "Does she work here?"
        }
      ],
      "references": ["CAM-A1-YLE"],
