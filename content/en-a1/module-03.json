    {
      "skill_id": "en-a1-011",
      "title": "Possessive determiners and possessive pronouns",
      "explanation": "Possessive determiners go before a noun: my, your, his, her, our, their (my bag, her house). Possessive pronouns replace the noun and stand alone: mine, yours, his, hers, ours, theirs (This bag is mine). Do not use my where mine is needed: not This bag is my. Do not use mine before a noun: not This is mine bag.",
      "examples": [
        {
          "en": "This is my bag."
        },
        {
          "en": "That bag is mine."
        },
        {
          "en": "Her house is big."
        }
      ],
      "references": ["CAM-A1-YLE"],
