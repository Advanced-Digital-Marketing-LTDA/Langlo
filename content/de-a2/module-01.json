    {
      "skill_id": "de-a2-003",
      "title": "Separable verbs in statements, questions and imperatives",
      "explanation": "Separable verbs split in main clauses: the stem takes the verb position and the prefix goes to the end. This holds in statements (Der Zug kommt um acht Uhr an), yes/no questions (Bringst du Brot mit?) and imperatives (Räum bitte dein Zimmer auf!). More frequent separable verbs: ankommen, abfahren, mitbringen, zurückkommen, aufräumen. The infinitive is written as one word.",
      "examples": [
        {
          "de": "Der Zug kommt um acht Uhr an.",
          "en": "The train arrives at eight o'clock."
        },
        {
          "de": "Bringst du Brot mit?",
          "en": "Are you bringing bread?"
        },
        {
          "de": "Räum bitte dein Zimmer auf!",
          "en": "Please clean up your room!"
        }
      ],
