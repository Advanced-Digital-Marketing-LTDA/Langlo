    {
      "skill_id": "de-a2-004",
      "title": "The sentence bracket with modal and separable verbs",
      "explanation": "German clauses often form a bracket: the finite verb stands in second position and the verb part that completes it stands at the end, with the other information in between. With a modal verb, a separable verb stays together as one infinitive at the end: Ich muss morgen früh aufstehen. The same holds in questions: Kannst du mich später anrufen? Do not split the infinitive after a modal.",
      "examples": [
        {
          "de": "Ich muss morgen früh aufstehen.",
          "en": "I have to get up early tomorrow."
        },
        {
          "de": "Wir wollen heute Abend einkaufen.",
          "en": "We want to shop this evening."
        },
        {
          "de": "Kannst du mich später anrufen?",
          "en": "Can you call me later?"
        }
      ],
