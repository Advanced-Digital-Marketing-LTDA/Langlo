    {
      "skill_id": "de-a2-016",
      "title": "Indefinite pronouns and quantity words",
      "explanation": "Use niemand (nobody), jemand (somebody), nichts (nothing), etwas (something) and alles (everything) as pronouns: Niemand ist zu Hause. Ich möchte etwas trinken. They need no article. For quantity use viele (many), wenige (few), einige (some) and alle (all) with plural nouns: Viele Kinder spielen im Garten. The verb agrees with the plural noun. Man (one, people) is a general subject: Man spricht Deutsch.",
      "examples": [
        {
          "de": "Niemand ist zu Hause.",
          "en": "Nobody is at home."
        },
        {
          "de": "Ich möchte etwas trinken.",
          "en": "I would like to drink something."
        },
        {
          "de": "Viele Kinder spielen im Garten.",
          "en": "Many children play in the garden."
        }
      ],
