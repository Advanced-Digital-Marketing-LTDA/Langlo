    {
      "skill_id": "de-a2-013",
      "title": "Demonstrative and interrogative determiners: dieser and welcher",
      "explanation": "Dieser (this) and welcher (which) take the same endings as the definite article: masculine dieser/welcher (nominative) and diesen/welchen (accusative), feminine diese/welche, neuter dieses/welches, plural diese/welche. Only the masculine changes in the accusative: Ich kaufe diesen Mantel. Welchen Pullover kaufst du? Welche Lampe gefällt dir?",
      "examples": [
        {
          "de": "Welchen Pullover kaufst du?",
          "en": "Which sweater are you buying?"
        },
        {
          "de": "Ich kaufe diesen Pullover.",
          "en": "I am buying this sweater."
        },
        {
          "de": "Welche Lampe gefällt dir?",
          "en": "Which lamp do you like?"
        }
      ],
