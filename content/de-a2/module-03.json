    {
      "skill_id": "de-a2-009",
      "title": "Two-way prepositions: accusative for motion, dative for location",
      "explanation": "The prepositions an, auf, in, über, unter, vor, hinter, neben and zwischen take the accusative when they show movement to a place (Wohin?) and the dative when they show where something is (Wo?). Ich gehe in die Stadt (motion, accusative). Ich wohne in der Stadt (location, dative). Das Buch liegt auf dem Tisch (location). Ich lege das Buch auf den Tisch (motion).",
      "examples": [
        {
          "de": "Das Buch liegt auf dem Tisch.",
          "en": "The book is lying on the table."
        },
        {
          "de": "Ich lege das Buch auf den Tisch.",
          "en": "I put the book on the table."
        },
        {
          "de": "Wir gehen in die Stadt.",
          "en": "We are going into the city."
        }
      ],
      "references": ["GOETHE-A2-FIT", "GOETHE-A2-ADULT", "GOETHE-DO-A2"],
