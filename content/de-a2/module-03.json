    {
      "skill_id": "de-a2-012",
      "title": "Possessive determiners in nominative and accusative",
      "explanation": "Possessive determiners decline like ein. Nominative: mein Bruder, meine Schwester, mein Haus, meine Eltern. Accusative: only the masculine changes (meinen Bruder); the feminine, neuter and plural forms stay the same (meine Schwester, mein Haus, meine Eltern). The same endings apply to dein, sein, ihr, unser, euer and Ihr. The stem shows the owner; the ending shows the case and the gender of the noun.",
      "examples": [
        {
          "de": "Ich besuche meinen Bruder.",
          "en": "I visit my brother."
        },
        {
          "de": "Sie liebt ihre Schwester.",
          "en": "She loves her sister."
        },
        {
          "de": "Wir besuchen unsere Eltern.",
          "en": "We visit our parents."
        }
      ],
      "references": ["GOETHE-A2-FIT", "GOETHE-A2-ADULT", "GOETHE-DO-A2"],
