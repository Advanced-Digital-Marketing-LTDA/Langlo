    {
      "skill_id": "de-a2-010",
      "title": "Accusative and dative personal pronouns in short clauses",
      "explanation": "Use accusative pronouns for direct objects (mich, dich, ihn, sie, es, uns, euch, sie) and dative pronouns for indirect objects and after verbs like helfen (mir, dir, ihm, ihr, ihm, uns, euch, ihnen). Ich rufe dich morgen an (accusative). Er gibt mir das Buch (dative). Kannst du mir helfen? (dative). Wir besuchen euch (accusative). Check the verb: it decides the case.",
      "examples": [
        {
          "de": "Ich rufe dich morgen an.",
          "en": "I will call you tomorrow."
        },
        {
          "de": "Er gibt mir das Buch.",
          "en": "He gives me the book."
        },
        {
          "de": "Kannst du mir helfen?",
          "en": "Can you help me?"
        }
      ],
