    {
      "skill_id": "en-a2-019",
      "title": "Question tags and short answers",
      "explanation": "A question tag is a short question added to a statement to check information. After a positive statement use a negative tag; after a negative statement use a positive tag: You are tired, aren't you? She can't swim, can she? The tag repeats the auxiliary verb. For a short answer repeat the auxiliary: Yes, I am. No, she can't. Do not repeat the whole sentence.",
      "examples": [
        {
          "en": "You are tired, aren't you?"
        },
        {
          "en": "She can't swim, can she?"
        },
        {
          "en": "Yes, I am."
        }
      ],
