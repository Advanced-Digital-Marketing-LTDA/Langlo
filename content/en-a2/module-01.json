    {
      "skill_id": "en-a2-001",
      "title": "Past simple: statements, negatives and questions",
      "explanation": "Use the past simple for finished actions. Regular verbs add -ed (visited); irregular verbs have special forms (bought, wrote, saw). For negatives use didn't (did not) plus the base verb: She didn't go to school. For questions use did plus the subject and the base verb: Did you see the film? After did and didn't the main verb has no past ending: not She didn't went.",
      "examples": [
        {
          "en": "I visited my aunt last week."
        },
        {
          "en": "She didn't go to school."
        },
        {
          "en": "Did you see the film?"
        }
      ],
