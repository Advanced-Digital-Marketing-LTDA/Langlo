{
  "name": "langlo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.19.x",
    "npm": "11.9.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "svelte-kit sync && vitest run",
    "test:property": "svelte-kit sync && vitest run .pbt.test.ts",
    "test:mutation": "node scripts/run-stryker.mjs",
    "test:e2e": "playwright test",
    "test:e2e:agent": "e2e run",
    "validate:curriculum": "node scripts/curriculum-contract.mjs",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview --host 127.0.0.1",
    "db:generate": "drizzle-kit generate --config src/lib/server/db/drizzle.config.ts",
    "db:fixture": "node tests/fixtures/cli.ts init",
    "db:migrate": "node tests/fixtures/cli.ts migrate",
    "db:seed:test": "node tests/fixtures/cli.ts seed",
    "db:test:reset": "node tests/fixtures/cli.ts reset",
    "db:fixture:dispose": "node tests/fixtures/cli.ts dispose",
    "db:remote-test": "node scripts/db-remote-test.ts",
    "accounts:provision": "node scripts/accounts-provision.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@libsql/client": "0.18.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "nodemailer": "10.0.13",
    "ts-fsrs": "5.4.2"
  },
  "overrides": {
    "better-auth": {
      "@sveltejs/kit": "$@sveltejs/kit"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@e2e-dev/web": "^0.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "^7.0.0",
    "drizzle-kit": "0.31.11",
    "e2e": "^0.19.0",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "overlock": "0.10.4",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.5",
    "zod": "^4.1.8"
  }
}
