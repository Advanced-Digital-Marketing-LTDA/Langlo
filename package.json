{
  "name": "langlo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.19.x",
    "npm": "11.9.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:property": "vitest run .pbt.test.ts",
    "test:e2e": "playwright test",
    "validate:curriculum": "node scripts/curriculum-contract.mjs",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview --host 127.0.0.1",
    "db:generate": "drizzle-kit generate --config src/lib/server/db/drizzle.config.ts",
    "db:fixture": "node tests/fixtures/cli.ts init",
    "db:migrate": "node tests/fixtures/cli.ts migrate",
    "db:seed:test": "node tests/fixtures/cli.ts seed",
    "db:test:reset": "node tests/fixtures/cli.ts reset",
    "db:fixture:dispose": "node tests/fixtures/cli.ts dispose"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.3",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "overlock": "0.10.4",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
